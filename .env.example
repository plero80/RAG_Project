# Gemini API key used for document and query embeddings.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Local PostgreSQL container settings (docker-compose.yml).
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=55432

# Python application connection string. Keep these values in sync with the
# settings above; replace the password here too. URL-encode special characters
# in the password when placing it in this URL.
POSTGRES_URL=postgresql://rag_user:replace_with_a_local_password@127.0.0.1:55432/rag_db
